# API wiring for the Asetto SPA.
#
# VITE_API_MODE: `mock` (default) runs fully in-browser against seeded data.
#                `live` talks to the real Asetto Laravel backend over cookies + CSRF.
VITE_API_MODE=mock

# Used only when VITE_API_MODE=live. Base URL of the Asetto backend (same eTLD+1
# as the SPA so the session cookie is shared). Example: http://asetto.akunta.local:8000
VITE_API_BASE=
